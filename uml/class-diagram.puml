package "calypso.crypto.symmetric" as api {
    class "SymmetricCryptoApiProperties" as ApiProperties <<constants>> <<green>> {
        +const VERSION: String = "0.2"
    }
    package spi {
        interface SymmetricCryptoCardTransactionManagerFactorySpi <<red>> {
            +isExtendedModeSupported() → Boolean
            +getMaxCardApduLengthSupported() → Int

            +preInitTerminalSessionContext() → Unit
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
    
            +createCardTransactionManager(cardKeyDiversifier: ByteArray, useExtendedMode: Boolean, <color:blue>exchangedApdus: MutableList<ByteArray></color>) → SymmetricCryptoCardTransactionManagerSpi
        }
        interface SymmetricCryptoCardTransactionManagerSpi <<red>> {
            +initTerminalSecureSessionContext() → ByteArray
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
            +initTerminalSessionMac(openSecureSessionDataOut: ByteArray, kif: Byte, kvc: Byte) → Unit
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
            +updateTerminalSessionMac(cardApdu: ByteArray) → ByteArray?
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
            +finalizeTerminalSessionMac() → ByteArray
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
    
            +generateTerminalSessionMac() → ByteArray
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
    
            +activateEncryption() → Unit
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
            +deactivateEncryption() → Unit
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
    
            +isCardSessionMacValid(cardSessionMac: ByteArray) → Boolean
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
    
            +computeSvCommandSecurityData(<color:blue>svGetRequest: ByteArray, svGetResponse: ByteArray, svCommandPartialRequest: ByteArray</color>) → <color:blue>SvCommandSecurityData</color>
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
            +isCardSvMacValid(cardSvMac: ByteArray) → Boolean
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
    
            +cipherPinForPresentation(cardChallenge: ByteArray, pin: ByteArray, kif: Byte, kvc: Byte) → ByteArray
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
            +cipherPinForModification(cardChallenge: ByteArray, currentPin: ByteArray, newPin: ByteArray, kif: Byte, kvc: Byte) → ByteArray
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
            +generateCipheredCardKey(cardChallenge: ByteArray, issuerKeyKif: Byte, issuerKeyKvc: Byte, targetKeyKif: Byte, targetKeyKvc: Byte) → ByteArray
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>

            +synchronize() → Unit
            {method} <size:10><color:#7F8C8D>    ⚠ errors: SymmetricCrypto, SymmetricCryptoIO</color></size>
        }
        class "<color:blue>SvCommandSecurityData" as SvCommandSecurityData <<data>> <<green>> {
            +val serialNumber: ByteArray
            +val transactionNumber: ByteArray
            +val terminalChallenge: ByteArray
            +val terminalSvMac: ByteArray
        }
    }
    exception "SymmetricCrypto\nSymmetricCryptoIO" as errors <<error>> <<green>> {
        +val message: String
        +val cause: Any?
    }
}

' Associations

SymmetricCryptoCardTransactionManagerFactorySpi ..> SymmetricCryptoCardTransactionManagerSpi #C_LINK : provide >

SymmetricCryptoCardTransactionManagerSpi ..> SvCommandSecurityData #C_LINK : provide >

' == LAYOUT ==

ApiProperties .[hidden]. errors

